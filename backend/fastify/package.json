{
  "name": "xiayh-personal-site-api",
  "description": "API service for Xiayh's personal website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "hash-password": "node scripts/hash-password.mjs",
    "seed:example": "node --env-file=../../.env --import tsx src/scripts/seed-example.ts",
    "seed:examples": "node --env-file=../../.env --import tsx src/scripts/seed-example.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^9.1.3",
    "fastify": "^5.8.5",
    "katex": "^0.17.0",
    "marked": "^18.0.5",
    "marked-katex-extension": "^5.1.10",
    "sanitize-html": "^2.17.5"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/sanitize-html": "^2.16.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
