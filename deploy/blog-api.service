[Unit]
Description=Xiayh Personal Website API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xiayh-site
Group=xiayh-site
WorkingDirectory=/opt/xiayh-personal-site
EnvironmentFile=/opt/xiayh-personal-site/blog.env
ExecStart=/usr/bin/node /opt/xiayh-personal-site/backend/dist/src/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/xiayh-personal-site/data

[Install]
WantedBy=multi-user.target
