NODE_ENV=production
HOST=127.0.0.1
PORT=8080
DATABASE_PATH=/opt/xiayh-personal-site/data/blog.sqlite3
NOTES_REPO=/opt/xiayh-personal-site/data/notes
MEDIA_ROOT=/opt/xiayh-personal-site/data/media
IMAGE_UPLOAD_LIMIT=5242880
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-scrypt-hash
JWT_SECRET=replace-with-at-least-32-random-characters
SYNC_TOKEN=replace-with-a-separate-32-character-random-token
JWT_EXPIRES_IN=8h
COOKIE_NAME=xiayh_site_session
COOKIE_SECURE=true
CORS_ORIGINS=https://xiayh.com.cn
REQUEST_BODY_LIMIT=1048576
TRUST_PROXY=true
